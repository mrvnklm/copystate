{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Copystate",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/mrvnklm/copystate",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_actionTitle__"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'none'; object-src 'none'"
  }
}
